generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase: DATABASE_URL usa el pooler (puerto 6543) porque Vercel abre muchas conexiones cortas;
  // DIRECT_URL (puerto 5432) se usa solo para migraciones, que el pooler en modo transacción no soporta.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Los tipos se guardan como String (no enums) para poder agregar valores sin migrar la base;
// los valores válidos se controlan en src/domain (DEBT_TYPES / TRANSACTION_TYPES).

// User y Account siguen el formato que exige @auth/prisma-adapter (Auth.js).
// passwordHash es nulo para quienes solo ingresan con Google; birthDate es nulo
// hasta que el usuario de Google completa su perfil.
model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  birthDate     DateTime?
  // Total mensual (fijo + variable) calculado a partir de las fuentes de ingreso; base para medir la carga de deudas.
  monthlyIncome Float?
  // Estimación gruesa del formulario de bienvenida; el detalle real vive en Debt.
  debtEstimatedTotal Float?
  debtPayoffMonths   Int?
  // Nulo mientras el usuario no termine (u omita) el formulario de bienvenida.
  onboardedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  debts         Debt[]
  transactions  Transaction[]
  incomeSources IncomeSource[]
  moneyAccounts MoneyAccount[]
  fixedExpenses FixedExpense[]
  resetTokens   PasswordResetToken[]
}

model FixedExpense {
  id            String   @id @default(cuid())
  userId        String
  category      String // HOUSING | ELECTRICITY | WATER | GAS | INTERNET_PHONE | TRANSPORT | FOOD | OTHER
  monthlyAmount Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IncomeSource {
  id            String   @id @default(cuid())
  userId        String
  origin        String // EMPLOYMENT | BUSINESS | FREELANCE | RENTAL | BENEFIT | OTHER
  name          String
  kind          String // FIXED | VARIABLE
  monthlyAmount Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Solo se guarda el hash del token: si la base se filtra, los enlaces enviados por correo no sirven.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Debt {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  type                  String   @default("DEBT") // DEBT | CREDIT_CARD
  totalAmount           Float
  remainingInstallments Int
  interestRate          Float?
  dueDate               DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments              Transaction[]

  @@index([userId, dueDate])
}

model MoneyAccount {
  id             String        @id @default(cuid())
  userId         String
  name           String
  kind           String // BANK | WALLET | CASH | OTHER
  currency       String // ISO 4217, ej: CLP | USD
  initialBalance Float         @default(0)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String // INCOME | EXPENSE
  amount      Float
  description String
  category    String?
  subtype     String? // DAILY | DEBT_PAYMENT | FIXED | OTHER (salida); FIXED | VARIABLE | OTHER (entrada)
  accountId   String?
  debtId      String?
  date        DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     MoneyAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debt        Debt?    @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}
