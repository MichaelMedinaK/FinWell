# Copia este archivo como .env (no se sube a git).

# --- Base de datos ---
# Desarrollo local con Docker (docker compose up -d):
DATABASE_URL="postgresql://finwell:finwell@localhost:5433/finwell"
DIRECT_URL="postgresql://finwell:finwell@localhost:5433/finwell"
# Producción con Supabase (Project Settings > Database > Connection string):
# DATABASE_URL = Transaction pooler (puerto 6543) + "?pgbouncer=true&connection_limit=1"
# DIRECT_URL   = Session pooler (puerto 5432)

# Moneda y locale para formatear montos (ISO 4217 / BCP 47)
NEXT_PUBLIC_CURRENCY="CLP"
NEXT_PUBLIC_LOCALE="es-CL"

# --- Copia lo siguiente en .env.local (no se sube a git) ---
# Secreto para firmar las sesiones. Genera uno con: npx auth secret
# AUTH_SECRET=""
# Opcional: login con Google (Google Cloud Console > Credenciales > ID de cliente OAuth)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
